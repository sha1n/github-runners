# Copy this file to .env and fill in your values. .env is gitignored.

# GitHub organization the runners attach to (e.g. my-org). Required.
GITHUB_ORG=

# Org-level runner registration token. Required.
# Get it from: Org Settings > Actions > Runners > New runner.
# Valid for ~1 hour; the same token registers all runners below within that window.
RUNNER_TOKEN=

# How many runners to register and launch. Positive integer. Required.
RUNNER_COUNT=3

# Optional: runner name prefix. Defaults to this machine's short hostname.
# Runners are named "<prefix>-1", "<prefix>-2", ...
RUNNER_NAME_PREFIX=

# Optional: extra labels (comma-separated), appended to the defaults
# "self-hosted,<os>,<arch>".
RUNNER_LABELS=

# Optional: which actions/runner release to download for first-time setup.
# Defaults to "latest". Pin e.g. 2.317.0 for a reproducible installed binary.
# Affects only the DOWNLOADED version — live runners auto-update themselves.
RUNNER_DOWNLOAD_VERSION=latest
