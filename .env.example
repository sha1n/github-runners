# Copy this file to .env and fill in your values. .env is gitignored.
# .env holds NON-SECRET config only. The credential is NOT kept here — see below.

# GitHub organization the runners attach to (e.g. my-org). Required.
GITHUB_ORG=

# How many runners to register and launch. Positive integer. Required.
RUNNER_COUNT=3

# Optional: runner name prefix. Defaults to this machine's short hostname.
# Runners are named "<prefix>-1", "<prefix>-2", ...
RUNNER_NAME_PREFIX=

# Optional: extra labels (comma-separated), appended to the defaults
# "self-hosted,<os>,<arch>".
RUNNER_LABELS=

# Optional: which actions/runner release to download for first-time setup.
# Defaults to "latest". Pin e.g. 2.317.0 for a reproducible installed binary.
# Affects only the DOWNLOADED version — live runners auto-update themselves.
RUNNER_DOWNLOAD_VERSION=latest

# --- Credential (NOT stored here) --------------------------------------------
# Authentication comes from your SHELL, not this file, so the secret never
# touches disk. Provide it one of two ways:
#
#   1. gh CLI (recommended): run `gh auth login` once. register.sh and
#      unregister.sh will use it automatically. Add the admin:org scope with:
#        gh auth refresh -h github.com -s admin:org
#
#   2. RUNNER_TOKEN env var: export it in your shell (or prefix the command).
#      It accepts EITHER:
#        - a Personal Access Token (admin:org / manage_runners:org scope) —
#          works for both register and unregister; or
#        - a short-lived registration token from Org Settings > Actions >
#          Runners > New runner — register.sh only.
#
#      export RUNNER_TOKEN=ghp_xxxxxxxx
#      # or, one-off:
#      RUNNER_TOKEN=ghp_xxxxxxxx ./register.sh
